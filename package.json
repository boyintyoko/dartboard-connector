{
  "type": "module",
  "name": "darts-room-desktop",
  "version": "1.0.2",
  "workspaces": {
    "packages": [
      "packages/**",
      "example"
    ]
  },
  "repository": "git@github.com:minimalcorp/dartboard-connector.git",
  "author": "Okuyama <okuyama@minimalcorp.com>",
  "scripts": {
    "build": "yarn workspace @minimalcorp/dartboard-connector tsc",
    "build:watch": "yarn workspace @minimalcorp/dartboard-connector tsc -w",
    "start-example": "yarn workspace @minimalcorp/dartboard-connector-example next",
    "start-match-server": "node online-server.js",
    "desktop:build": "node desktop/build.mjs",
    "desktop:run": "npm run desktop:build && electron .",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "ci": "yarn workspaces run ci",
    "test:game": "node tests/game-check.mjs",
    "test:matchmaking": "node tests/matchmaking-check.mjs",
    "test:bluetooth": "tsc -p packages/dartboard-connector/tsconfig.json && node tests/bluetooth-check.mjs"
  },
  "private": true,
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.dartsroom.desktop",
    "productName": "Darts Room",
    "asar": true,
    "asarUnpack": [
      "desktop/app/**/*"
    ],
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
